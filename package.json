{
  "name": "cortico-world-lofter",
  "version": "0.1.2",
  "type": "module",
  "description": "以自有登录态读取 LOFTER 内容。支持热榜、单篇正文与配图；按需取用，不落盘、不订阅；失败时明确报错。",
  "license": "MIT",
  "author": "苏鸿与维基 (suhong11300)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/cortico-world-lofter.git"
  },
  "homepage": "https://github.com/suhong11300/cortico-world-lofter#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/cortico-world-lofter/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "lofter",
    "blog",
    "reader",
    "netease"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "tags": [
      "internet",
      "requires-key"
    ],
    "describe": "describe.json",
    "displayName": "LOFTER 阅读",
    "icon": "icon.svg",
    "locales": {
      "zh": {
        "displayName": "LOFTER 阅读",
        "description": "以自有登录态读取 LOFTER 内容。支持热榜、单篇正文与配图；按需取用，不落盘、不订阅；失败时明确报错。"
      },
      "en": {
        "displayName": "LOFTER Reader",
        "description": "Reads LOFTER with your own login session. Covers hot posts, single articles and images; fetched on demand, never archived or subscribed; failures are reported explicitly."
      }
    }
  },
  "files": [
    "src",
    "icon.svg",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepublishOnly": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "describe": "tsx scripts/describe.mts",
    "describe:check": "tsx scripts/describe.mts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
